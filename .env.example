WEATHER_PROVIDER=weatherapi
WEATHERAPI_KEY=
OPENWEATHERMAP_API_KEY=
DEFAULT_LOCATION=Coimbatore, India
GREENHOUSE_TYPE=medium
TARGET_TEMPERATURE_C=28
DATABASE_URL=sqlite:///data/greentwin.db
GREENTWIN_ENABLE_BACKGROUND_POLLING=true
GREENTWIN_POLL_INTERVAL_SECONDS=60
GREENTWIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
